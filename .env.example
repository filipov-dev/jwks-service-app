# Database connection URL
DATABASE_URL=postgres://user:password@db:5432/jwk_db

# Run database migrations on application start (1 = true, 0 = false)
RUN_MIGRATIONS_ON_START=1

# Private key expiration time in seconds (default: 1 day)
PRIVATE_KEY_EXPIRATION_SECONDS=86400

# Key expiration time in seconds (default: 2 days)
KEY_EXPIRATION_SECONDS=172800

# Address the service binds to (default: 127.0.0.1).
# Localhost only by default: inside a container the service stays unreachable
# from outside until HOST is set explicitly, e.g. HOST=0.0.0.0.
HOST=127.0.0.1

# Port the service listens on (default: 8080).
# Must be a number between 1 and 65535, otherwise startup fails with an error.
PORT=8080
